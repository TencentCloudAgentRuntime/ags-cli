{
    "api_version": "v20250920",
    "commands": {
        "deployment.create": {
            "short": "Create a deployment",
            "long": "Create a remotely managed Deployment. Complex configuration fields accept a JSON value, @file, or - for stdin.",
            "examples": [
                "Example - Scale to zero after five idle minutes:\n  agr deployment create \\\n    --deployment-name workspace-service \\\n    --tool-id sdt-a1b2c3d4 \\\n    --scaling-configuration '{\"MinInstanceCount\":0,\"MaxInstanceCount\":10,\"MaxInstanceRequestConcurrency\":100}' \\\n    --lifecycle-configuration '{\"IdleTimeoutSeconds\":300,\"IdleAction\":\"STOP\"}'",
                "Example - Keep two instances active:\n  agr deployment create \\\n    --deployment-name latency-sensitive-service \\\n    --tool-id sdt-a1b2c3d4 \\\n    --scaling-configuration '{\"MinInstanceCount\":2,\"MaxInstanceCount\":20,\"MaxInstanceRequestConcurrency\":200}'",
                "Example - Prefer the same instance for requests sharing an affinity ID:\n  agr deployment create \\\n    --deployment-name session-service \\\n    --tool-id sdt-a1b2c3d4 \\\n    --affinity-configuration '{\"Mode\":\"BEST_EFFORT\",\"HeaderName\":\"X-Tencent-Agr-Affinity-Id\"}'",
                "Example - Fail instead of selecting another instance for an affinity ID:\n  agr deployment create \\\n    --deployment-name strict-session-service \\\n    --tool-id sdt-a1b2c3d4 \\\n    --affinity-configuration '{\"Mode\":\"STRICT\",\"HeaderName\":\"X-Tencent-Agr-Affinity-Id\"}'",
                "Example - Give each affinity ID an exclusive, non-migrating instance:\n  agr deployment create \\\n    --deployment-name exclusive-session-service \\\n    --tool-id sdt-a1b2c3d4 \\\n    --affinity-configuration '{\"Mode\":\"EXCLUSIVE\",\"HeaderName\":\"X-Tencent-Agr-Affinity-Id\"}'",
                "Example - Load configuration from files and capture the Deployment ID:\n  deployment_id=$(agr deployment create \\\n    --deployment-name workspace-service \\\n    --tool-id sdt-a1b2c3d4 \\\n    --scaling-configuration @scaling.json \\\n    --lifecycle-configuration @lifecycle.json \\\n    --tags @tags.json \\\n    -o json --jq '.Data.Deployment.DeploymentId')"
            ],
            "fields": {
                "DeploymentName": {
                    "description": "Unique DNS-1123 deployment name.",
                    "inputs": {
                        "deployment-name": {
                            "usage": "Unique DNS-1123 deployment name (required)"
                        }
                    }
                },
                "ToolId": {
                    "description": "Associated sandbox tool ID.",
                    "inputs": {
                        "tool-id": {
                            "usage": "Associated sandbox tool ID"
                        }
                    }
                },
                "ScalingConfiguration": {
                    "description": "Scaling configuration.",
                    "inputs": {
                        "scaling-configuration": {
                            "usage": "ScalingConfiguration JSON object, @file, or - for stdin"
                        }
                    }
                },
                "LifecycleConfiguration": {
                    "description": "Idle lifecycle configuration.",
                    "inputs": {
                        "lifecycle-configuration": {
                            "usage": "LifecycleConfiguration JSON object, @file, or - for stdin"
                        }
                    }
                },
                "AffinityConfiguration": {
                    "description": "Session affinity configuration.",
                    "inputs": {
                        "affinity-configuration": {
                            "usage": "AffinityConfiguration JSON object, @file, or - for stdin"
                        }
                    }
                },
                "Tags": {
                    "description": "Resource tags.",
                    "inputs": {
                        "tags": {
                            "usage": "Tags JSON array, @file, or - for stdin"
                        }
                    }
                }
            }
        },
        "deployment.delete": {
            "short": "Delete a deployment",
            "long": "Delete a Deployment and wait for its asynchronous deletion to finish by default.",
            "examples": [
                "Example - Delete and wait for completion:\n  agr deployment delete dpl-a1b2c3d4",
                "Example - Allow up to 30 minutes for deletion:\n  agr deployment delete dpl-a1b2c3d4 --timeout 30m",
                "Example - Return as soon as the delete request is accepted:\n  agr deployment delete dpl-a1b2c3d4 --wait=false",
                "Example - Wait without a deadline:\n  agr deployment delete dpl-a1b2c3d4 --timeout 0"
            ]
        },
        "deployment.get": {
            "short": "Describe a deployment",
            "examples": [
                "Example - Inspect the Deployment in a human-readable form:\n  agr deployment get dpl-a1b2c3d4",
                "Example - Print the complete API response:\n  agr deployment get dpl-a1b2c3d4 -o json",
                "Example - Extract the current status for a script:\n  agr deployment get dpl-a1b2c3d4 -o json --jq '.Data.Deployment.Status'"
            ]
        },
        "deployment.list": {
            "short": "List deployments",
            "examples": [
                "Example - List Deployments with compact status and capacity summaries:\n  agr deployment list",
                "Example - List active Deployments for one Sandbox Tool:\n  agr deployment list --filters '[{\"Name\":\"tool-id\",\"Values\":[\"sdt-a1b2c3d4\"]},{\"Name\":\"status\",\"Values\":[\"ACTIVE\"]}]'",
                "Example - Find Deployment names containing workspace:\n  agr deployment list --filters '[{\"Name\":\"deployment-name-like\",\"Values\":[\"workspace\"]}]'",
                "Example - Find Deployments whose last deletion failed:\n  agr deployment list --filters '[{\"Name\":\"status\",\"Values\":[\"DELETE_FAILED\"]}]'",
                "Example - Read the next page of Deployment IDs:\n  agr deployment list --offset 50 --limit 50 -o json --jq '(.Data.DeploymentSet // [])[].DeploymentId'"
            ],
            "fields": {
                "Filters": {
                    "description": "Deployment query filters.",
                    "inputs": {
                        "filters": {
                            "usage": "Filters JSON array, @file, or - for stdin. Names and values are case-sensitive; different filters use AND, while Values within one filter use OR.",
                            "format": "[{\"Name\":\"<filter>\",\"Values\":[\"<value>\"]}]",
                            "values": [
                                "deployment-id: exact Deployment ID",
                                "deployment-name: exact Deployment name",
                                "deployment-name-like: literal substring of the Deployment name; % and _ are not wildcards",
                                "tool-id: exact Sandbox Tool ID",
                                "status: exact status; ACTIVE, DELETING, or DELETE_FAILED"
                            ]
                        }
                    }
                }
            }
        },
        "deployment.update": {
            "short": "Update a deployment",
            "long": "Update the mutable configuration of a remotely managed Deployment. Provided configuration objects replace their current values in full.",
            "examples": [
                "Example - Increase active capacity:\n  agr deployment update dpl-a1b2c3d4 \\\n    --scaling-configuration '{\"MinInstanceCount\":2,\"MaxInstanceCount\":20,\"MaxInstanceRequestConcurrency\":200}'",
                "Example - Pause idle instances after ten minutes and retain their state:\n  agr deployment update dpl-a1b2c3d4 \\\n    --lifecycle-configuration '{\"IdleTimeoutSeconds\":600,\"IdleAction\":\"PAUSE\"}'",
                "Example - Stop idle instances after five minutes:\n  agr deployment update dpl-a1b2c3d4 \\\n    --lifecycle-configuration '{\"IdleTimeoutSeconds\":300,\"IdleAction\":\"STOP\"}'",
                "Example - Replace all tags:\n  agr deployment update dpl-a1b2c3d4 \\\n    --tags '[{\"Key\":\"env\",\"Value\":\"production\"},{\"Key\":\"team\",\"Value\":\"agent-platform\"}]'",
                "Example - Clear all tags:\n  agr deployment update dpl-a1b2c3d4 --tags '[]'"
            ],
            "fields": {
                "ScalingConfiguration": {
                    "description": "Complete replacement scaling configuration.",
                    "inputs": {
                        "scaling-configuration": {
                            "usage": "Complete ScalingConfiguration JSON object, @file, or - for stdin"
                        }
                    }
                },
                "LifecycleConfiguration": {
                    "description": "Complete replacement idle lifecycle configuration.",
                    "inputs": {
                        "lifecycle-configuration": {
                            "usage": "Complete LifecycleConfiguration JSON object, @file, or - for stdin"
                        }
                    }
                },
                "Tags": {
                    "description": "Complete replacement resource tags.",
                    "inputs": {
                        "tags": {
                            "usage": "Complete Tags JSON array, @file, or - for stdin"
                        }
                    }
                }
            }
        },
        "instance.create": {
            "short": "Create a new sandbox instance",
            "long": "Create a new sandbox instance from a tool template.\n\nThe referenced tool must already exist. Create one first with `agr tool create`, or pass an existing --tool-id.\n\nUse --tool-name/-t for tool name or --tool-id for tool ID.\n\nComplex API fields such as --mount-options, --metadata, and --custom-configuration accept JSON, @file, or - for stdin.\n\nAuth mode (--auth-mode):\n  DEFAULT  Use backend default (currently TOKEN)\n  TOKEN    All ports require X-Access-Token\n  PUBLIC   envd management port (49983) requires token; other ports open\n  NONE     No authentication on any port",
            "examples": [
                "agr instance create --tool-id sdt-xxxx",
                "agr instance create --tool-name my-tool",
                "agr instance create -t my-tool --timeout 5m",
                "agr instance create --tool-id sdt-xxxx --mount-options '[{\"Name\":\"data\",\"MountPath\":\"/workspace\"}]'",
                "agr instance create -t my-tool --auth-mode NONE"
            ],
            "fields": {
                "ToolName": {
                    "description": "Tool name.",
                    "inputs": {
                        "tool-name": {
                            "usage": "Tool name"
                        }
                    }
                },
                "ToolId": {
                    "description": "Tool ID.",
                    "inputs": {
                        "tool-id": {
                            "usage": "Tool ID"
                        }
                    }
                },
                "Timeout": {
                    "description": "Instance timeout.",
                    "inputs": {
                        "timeout": {
                            "usage": "Instance timeout as accepted by the API, for example 5m, 300s, or 1h"
                        }
                    }
                },
                "MountOptions": {
                    "description": "Storage mount options for the instance.",
                    "inputs": {
                        "mount-options": {
                            "usage": "MountOptions as JSON array, @file, or - for stdin",
                            "format": "[{\"Name\":\"<name>\",\"MountPath\":\"<path>\"}]",
                            "examples": [
                                "agr instance create --tool-id sdt-xxxx --mount-options '[{\"Name\":\"data\",\"MountPath\":\"/workspace\"}]'",
                                "agr instance create --tool-id sdt-xxxx --mount-options @mounts.json"
                            ]
                        }
                    }
                },
                "CustomConfiguration": {
                    "description": "Custom configuration for the sandbox instance.",
                    "inputs": {
                        "custom-configuration": {
                            "usage": "CustomConfiguration JSON object, @file, or - for stdin",
                            "format": "{\"Image\":\"<registry>/<image>:<tag>\",\"Env\":[{\"Name\":\"KEY\",\"Value\":\"VAL\"}],\"Ports\":[{\"Name\":\"app\",\"Port\":8080,\"Protocol\":\"TCP\"}],\"Resources\":{\"CPU\":\"2\",\"Memory\":\"4Gi\",\"Storage\":\"10Gi\"}}",
                            "examples": [
                                "agr instance create --tool-id sdt-xxxx --custom-configuration '{\"Env\":[{\"Name\":\"MY_VAR\",\"Value\":\"hello\"}],\"Resources\":{\"Storage\":\"10Gi\"}}'"
                            ]
                        }
                    }
                },
                "Metadata": {
                    "description": "Instance metadata.",
                    "inputs": {
                        "metadata": {
                            "usage": "Metadata as JSON array, @file, or - for stdin",
                            "format": "[{\"Key\":\"<key>\",\"Value\":\"<value>\"}]",
                            "examples": [
                                "agr instance create --tool-id sdt-xxxx --metadata '[{\"Key\":\"env\",\"Value\":\"test\"}]'"
                            ]
                        }
                    }
                },
                "AuthMode": {
                    "description": "Sandbox access authentication mode.",
                    "inputs": {
                        "auth-mode": {
                            "usage": "Auth mode: DEFAULT, TOKEN, NONE, PUBLIC",
                            "values": [
                                "DEFAULT",
                                "TOKEN",
                                "NONE",
                                "PUBLIC"
                            ]
                        }
                    }
                },
                "ClientToken": {
                    "description": "Client token for duplicate creation protection.",
                    "inputs": {
                        "client-token": {
                            "usage": "Client token for duplicate creation protection"
                        }
                    }
                }
            }
        },
        "instance.list": {
            "short": "List instances",
            "long": "List sandbox instances with optional filters.",
            "examples": [
                "agr instance list",
                "agr instance list --tool-id sdt-xxxx",
                "agr instance list --filters '[{\"Name\":\"Status\",\"Values\":[\"RUNNING\"]}]'",
                "agr instance list --offset 0 --limit 50"
            ],
            "fields": {
                "ToolId": {
                    "description": "Filter by tool ID.",
                    "inputs": {
                        "tool-id": {
                            "usage": "Filter by tool ID"
                        }
                    }
                },
                "InstanceIds": {
                    "description": "Filter by instance IDs.",
                    "inputs": {
                        "instance-ids": {
                            "usage": "Filter by instance IDs",
                            "format": "--instance-ids <id1> --instance-ids <id2>",
                            "examples": [
                                "agr instance list --instance-ids ins-xxxx",
                                "agr instance list --instance-ids ins-xxxx --instance-ids ins-yyyy"
                            ]
                        }
                    }
                },
                "Filters": {
                    "description": "Additional list filters.",
                    "inputs": {
                        "filters": {
                            "usage": "Additional filters as JSON array, @file, or - for stdin",
                            "format": "[{\"Name\":\"<field>\",\"Values\":[\"<value1>\",\"<value2>\"]}]",
                            "values": [
                                "Status (persisted): STARTING, RUNNING, STARTING_FAILED, PAUSING, PAUSED, PAUSE_FAILED, RESUME_FAILED, FORK_FAILED, STOPPING, STOPPED, STOPPING_FAILED, FAILED",
                                "Status (derived): UNHEALTHY; use it as the sole Status value; --limit/--offset are ignored",
                                "RUNNING filter results may be displayed as UNHEALTHY",
                                "ToolName: tool name used to create the instance",
                                "ToolId: tool ID"
                            ],
                            "examples": [
                                "agr instance list --filters '[{\"Name\":\"Status\",\"Values\":[\"RUNNING\"]}]'",
                                "agr instance list --filters '[{\"Name\":\"Status\",\"Values\":[\"RUNNING\",\"STARTING\"]}]'",
                                "agr instance list --filters '[{\"Name\":\"Status\",\"Values\":[\"RUNNING\"]},{\"Name\":\"ToolName\",\"Values\":[\"my-tool\"]}]'"
                            ]
                        }
                    }
                },
                "Offset": {
                    "description": "Pagination offset.",
                    "inputs": {
                        "offset": {
                            "usage": "Pagination offset"
                        }
                    }
                },
                "Limit": {
                    "description": "Pagination limit.",
                    "inputs": {
                        "limit": {
                            "usage": "Pagination limit (max 100)"
                        }
                    }
                }
            }
        },
        "instance.update": {
            "short": "Update instance",
            "fields": {
                "Timeout": {
                    "description": "New timeout.",
                    "inputs": {
                        "timeout": {
                            "usage": "New timeout such as 10m or 300s"
                        }
                    }
                },
                "Metadata": {
                    "description": "Instance metadata.",
                    "inputs": {
                        "metadata": {
                            "usage": "Metadata as JSON array, @file, or - for stdin",
                            "format": "[{\"Key\":\"<key>\",\"Value\":\"<value>\"}]",
                            "examples": [
                                "agr instance update <id> --metadata '[{\"Key\":\"env\",\"Value\":\"prod\"}]'"
                            ]
                        }
                    }
                }
            }
        },
        "instance.pause": {
            "short": "Pause instance",
            "long": "Pause a sandbox instance. Use --memory to preserve process and memory state; omit it to use the service default.",
            "examples": [
                "agr instance pause ins-xxxx",
                "agr instance pause ins-xxxx --memory"
            ],
            "fields": {
                "Memory": {
                    "description": "Whether to preserve process and memory state while paused.",
                    "inputs": {
                        "memory": {
                            "usage": "Preserve process and memory state; use --memory=false for disk-only pause"
                        }
                    }
                }
            }
        },
        "instance.resume": {
            "short": "Resume instance",
            "long": "Resume a paused sandbox instance, optionally setting the automatic recycle timeout.",
            "examples": [
                "agr instance resume ins-xxxx",
                "agr instance resume ins-xxxx --timeout 10m"
            ],
            "fields": {
                "Timeout": {
                    "description": "Automatic recycle timeout after resume.",
                    "inputs": {
                        "timeout": {
                            "usage": "Timeout from 30s to 24h, for example 5m, 300s, or 1h"
                        }
                    }
                }
            }
        },
        "instance.delete": {
            "short": "Delete instances",
            "long": "Delete one or more sandbox instances. This operation executes immediately and does not prompt for confirmation."
        },
        "tool.create": {
            "short": "Create a new sandbox tool",
            "long": "Create a new sandbox tool template.\n\nTool names must be unique within the current AppId.\n\nFor a minimal code-interpreter tool, provide a unique name, `--tool-type code-interpreter`, and a network configuration such as `{\"NetworkMode\":\"SANDBOX\"}`.",
            "examples": [
                "tool_name=\"my-tool-$(date +%s)-$$\"",
                "agr tool create --tool-name \"$tool_name\" --tool-type code-interpreter --network-configuration '{\"NetworkMode\":\"SANDBOX\"}'",
                "agr tool create --tool-name \"$tool_name\" --tool-type code-interpreter --network-configuration '{\"NetworkMode\":\"SANDBOX\"}' -o json --jq '.Data.ToolId'"
            ],
            "fields": {
                "ToolName": {
                    "description": "Tool name.",
                    "inputs": {
                        "tool-name": {
                            "usage": "Tool name (required)"
                        }
                    }
                },
                "ToolType": {
                    "description": "Tool type.",
                    "inputs": {
                        "tool-type": {
                            "usage": "Tool type (required)",
                            "values": [
                                "browser",
                                "code-interpreter",
                                "mobile",
                                "osworld",
                                "custom",
                                "swebench",
                                "aio",
                                "android-world",
                                "waa"
                            ]
                        }
                    }
                },
                "Description": {
                    "description": "Tool description.",
                    "inputs": {
                        "description": {
                            "usage": "Tool description"
                        }
                    }
                },
                "DefaultTimeout": {
                    "description": "Default timeout.",
                    "inputs": {
                        "default-timeout": {
                            "usage": "Default timeout as accepted by the API, for example 5m, 300s, or 1h"
                        }
                    }
                },
                "NetworkConfiguration": {
                    "description": "Network configuration.",
                    "inputs": {
                        "network-configuration": {
                            "usage": "NetworkConfiguration as JSON object, @file, or - for stdin",
                            "format": "{\"NetworkMode\":\"<mode>\",\"VpcConfig\":{\"SubnetIds\":[\"subnet-xxx\"],\"SecurityGroupIds\":[\"sg-xxx\"]}}",
                            "values": [
                                "SANDBOX: no external network access",
                                "PUBLIC: public internet access",
                                "VPC: VPC network access; requires VpcConfig"
                            ],
                            "examples": [
                                "agr tool create -n my-tool -t code-interpreter --network-configuration '{\"NetworkMode\":\"SANDBOX\"}'",
                                "agr tool create -n my-tool -t code-interpreter --network-configuration '{\"NetworkMode\":\"PUBLIC\"}'",
                                "agr tool create -n my-tool -t custom --network-configuration '{\"NetworkMode\":\"VPC\",\"VpcConfig\":{\"SubnetIds\":[\"subnet-xxx\"],\"SecurityGroupIds\":[\"sg-xxx\"]}}'"
                            ]
                        }
                    }
                },
                "Tags": {
                    "description": "Tags.",
                    "inputs": {
                        "tags": {
                            "usage": "Tags as JSON array, @file, or - for stdin",
                            "format": "[{\"Key\":\"<key>\",\"Value\":\"<value>\"}]",
                            "examples": [
                                "agr tool create -n my-tool -t code-interpreter --network-configuration '{\"NetworkMode\":\"SANDBOX\"}' --tags '[{\"Key\":\"team\",\"Value\":\"platform\"},{\"Key\":\"env\",\"Value\":\"staging\"}]'"
                            ]
                        }
                    }
                },
                "RoleArn": {
                    "description": "Role ARN for COS access.",
                    "inputs": {
                        "role-arn": {
                            "usage": "Role ARN for COS access"
                        }
                    }
                },
                "StorageMounts": {
                    "description": "Storage mount configuration.",
                    "inputs": {
                        "storage-mounts": {
                            "usage": "StorageMounts as JSON array, @file, or - for stdin",
                            "format": "[{\"Name\":\"<name>\",\"MountPath\":\"<path>\",\"ReadOnly\":false,\"StorageSource\":{\"Cos\":{...}}}] or [{\"Name\":\"<name>\",\"MountPath\":\"<path>\",\"StorageSource\":{\"AgentBucket\":{\"LibraryId\":\"<library-id>\",\"SpaceId\":\"<space-id>\",\"AccessDomain\":\"<domain>\"}}}]",
                            "values": [
                                "Cos: Tencent Cloud Object Storage source",
                                "Image: container image volume source",
                                "Cfs: Cloud File Storage source",
                                "AgentBucket: AgentBucket source with LibraryId, SpaceId, and AccessDomain"
                            ],
                            "examples": [
                                "agr tool create -n my-tool -t custom --network-configuration '{\"NetworkMode\":\"PUBLIC\"}' --role-arn qcs::cam::uin/100000:roleName/my-role --storage-mounts '[{\"Name\":\"data\",\"MountPath\":\"/data\",\"StorageSource\":{\"Cos\":{\"Endpoint\":\"cos.ap-guangzhou.myqcloud.com\",\"BucketName\":\"my-bucket\",\"BucketPath\":\"/workspace\"}}}]'"
                            ]
                        }
                    }
                },
                "CustomConfiguration": {
                    "description": "Custom configuration.",
                    "inputs": {
                        "custom-configuration": {
                            "usage": "CustomConfiguration JSON object, @file, or - for stdin",
                            "format": "{\"Image\":\"<registry>/<image>:<tag>\",\"ImageRegistryType\":\"personal\",\"Command\":[\"/bin/sh\"],\"Args\":[\"-c\",\"sleep 3600\"],\"Env\":[{\"Name\":\"KEY\",\"Value\":\"VAL\"}],\"Ports\":[{\"Name\":\"app\",\"Port\":8080,\"Protocol\":\"TCP\"}],\"Resources\":{\"CPU\":\"2\",\"Memory\":\"4Gi\",\"Storage\":\"10Gi\"}}",
                            "examples": [
                                "agr tool create -n my-tool -t custom --network-configuration '{\"NetworkMode\":\"PUBLIC\"}' --custom-configuration '{\"Image\":\"ubuntu:22.04\",\"ImageRegistryType\":\"personal\",\"Resources\":{\"CPU\":\"2\",\"Memory\":\"4Gi\",\"Storage\":\"10Gi\"}}'"
                            ]
                        }
                    }
                },
                "LogConfiguration": {
                    "description": "Log configuration.",
                    "inputs": {
                        "log-configuration": {
                            "usage": "LogConfiguration JSON object, @file, or - for stdin",
                            "format": "{\"CLSConfig\":{\"TopicId\":\"<cls-topic-id>\"}}",
                            "examples": [
                                "agr tool create -n my-tool -t code-interpreter --network-configuration '{\"NetworkMode\":\"SANDBOX\"}' --log-configuration '{\"CLSConfig\":{\"TopicId\":\"xxxxx-xxxx-xxxx\"}}'"
                            ]
                        }
                    }
                },
                "Persistent": {
                    "description": "Whether the sandbox tool creates persistent sandboxes.",
                    "inputs": {
                        "persistent": {
                            "usage": "Whether the sandbox tool creates persistent sandboxes"
                        }
                    }
                },
                "ClientToken": {
                    "description": "Client token for duplicate creation protection.",
                    "inputs": {
                        "client-token": {
                            "usage": "Client token for duplicate creation protection"
                        }
                    }
                }
            }
        },
        "tool.list": {
            "short": "List available tools",
            "fields": {
                "ToolIds": {
                    "description": "Filter by tool IDs.",
                    "inputs": {
                        "tool-ids": {
                            "usage": "Filter by tool IDs",
                            "format": "--tool-ids <id1> --tool-ids <id2>",
                            "examples": [
                                "agr tool list --tool-ids sdt-xxxx",
                                "agr tool list --tool-ids sdt-xxxx --tool-ids sdt-yyyy"
                            ]
                        }
                    }
                },
                "Filters": {
                    "description": "Additional list filters.",
                    "inputs": {
                        "filters": {
                            "usage": "Additional filters as JSON array, @file, or - for stdin",
                            "format": "[{\"Name\":\"<field>\",\"Values\":[\"<value1>\",\"<value2>\"]}]",
                            "values": [
                                "ToolName: exact tool name",
                                "ToolType: browser, code-interpreter, custom, computer, mobile",
                                "Status: CREATING, ACTIVE, DELETING, FAILED"
                            ],
                            "examples": [
                                "agr tool list --filters '[{\"Name\":\"ToolType\",\"Values\":[\"code-interpreter\"]}]'",
                                "agr tool list --filters '[{\"Name\":\"Status\",\"Values\":[\"ACTIVE\"]}]'",
                                "agr tool list --filters '[{\"Name\":\"ToolType\",\"Values\":[\"browser\"]},{\"Name\":\"Status\",\"Values\":[\"ACTIVE\"]}]'"
                            ]
                        }
                    }
                },
                "Offset": {
                    "description": "Pagination offset.",
                    "inputs": {
                        "offset": {
                            "usage": "Pagination offset"
                        }
                    }
                },
                "Limit": {
                    "description": "Pagination limit.",
                    "inputs": {
                        "limit": {
                            "usage": "Pagination limit"
                        }
                    }
                }
            }
        },
        "tool.update": {
            "short": "Update a sandbox tool",
            "fields": {
                "Description": {
                    "description": "Tool description.",
                    "inputs": {
                        "description": {
                            "usage": "Tool description"
                        }
                    }
                },
                "NetworkConfiguration": {
                    "description": "Network configuration.",
                    "inputs": {
                        "network-configuration": {
                            "usage": "NetworkConfiguration as JSON object, @file, or - for stdin",
                            "format": "{\"NetworkMode\":\"<mode>\",\"VpcConfig\":{\"SubnetIds\":[\"subnet-xxx\"],\"SecurityGroupIds\":[\"sg-xxx\"]}}",
