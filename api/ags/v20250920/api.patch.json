  {
    "op": "add",
    "path": "/objects/CreateVolumeTemplateRequest",
    "value": {
      "document": "CreateVolumeTemplate请求参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "<p>VolumeTemplate 名称，在当前认证 AppId 内唯一。</p>",
          "member": "string",
          "name": "VolumeTemplateName",
          "required": true,
          "type": "string",
          "example": "agent-session-workspace"
        },
        {
          "disabled": false,
          "document": "<p>访问模式。</p><p>枚举值：</p><ul><li>ReadWriteOnce：单实例独占读写</li><li>ReadWriteMany：多实例共享读写</li><li>ReadOnlyMany：多实例共享只读</li></ul>",
          "member": "string",
          "name": "AccessMode",
          "required": true,
          "type": "string",
          "example": "ReadWriteOnce"
        },
        {
          "disabled": false,
          "document": "<p>回收策略。</p><p>枚举值：</p><ul><li>Retain：派生出的 Volume 在沙箱删除后保留</li><li>Delete：派生出的 Volume 在沙箱删除后一并删除</li></ul>",
          "member": "string",
          "name": "ReclaimPolicy",
          "required": true,
          "type": "string",
          "example": "Retain"
        },
        {
          "disabled": false,
          "document": "<p>模板存储规格。Cos、Cfs 必须且只能设置一个。</p>",
          "member": "StorageSpec",
          "name": "StorageSpec",
          "required": true,
          "type": "object",
          "example": "无"
        },
        {
          "disabled": false,
          "document": "<p>存储类型。StorageSpec 中对应类型的字段必须与该值一致。</p><p>枚举值：</p><ul><li>Cos：使用 COS 作为存储后端</li><li>Cfs：使用 CFS 作为存储后端</li></ul>",
          "member": "string",
          "name": "StorageType",
          "required": true,
          "type": "string",
          "example": "Cfs"
        },
        {
          "disabled": false,
          "document": "<p>派生 Volume 名称模板，必须包含 ${reuse_key}。</p>",
          "member": "string",
          "name": "VolumeNamePattern",
          "required": true,
          "type": "string",
          "example": "agent-workspace-${reuse_key}"
        },
        {
          "disabled": false,
          "document": "<p>预留容量字段，COS/CFS 后端不生效。</p>",
          "member": "string",
          "name": "DefaultCapacity",
          "required": false,
          "type": "string",
          "example": "100Gi"
        },
        {
          "disabled": false,
          "document": "<p>访问底层存储使用的角色 ARN。</p>",
          "member": "string",
          "name": "StorageRoleArn",
          "required": false,
          "type": "string",
          "example": "qcs::cam::uin/100000000001:roleName/AGSCFSRole"
        },
        {
          "disabled": false,
          "document": "<p>资源标签。</p>",
          "member": "Tag",
          "name": "Tags",
          "required": false,
          "type": "list",
          "example": "无"
        },
        {
          "disabled": false,
          "document": "<p>幂等 Token，最长 64 字符。重复提交相同 Token 与相同参数时返回首次创建的结果。</p>",
          "member": "string",
          "name": "ClientToken",
          "required": false,
          "type": "string",
          "example": "create-volume-template-workspace"
        }
      ],
      "type": "object"
    }
  },
